<div x-data="animeHomeComponent()" x-init="init()" x-cloak>
  <h2 class="uk-title">Anime</h2>

  <div class="uk-grid-small uk-child-width-1-2 uk-child-width-1-4@m" uk-grid>
    <div>
      <a class="uk-link-reset" href="<%= base_url %>anime/browse">
        <div class="uk-card uk-card-default uk-card-hover uk-card-body uk-text-center">
          <span uk-icon="search" style="font-size: 48px;"></span>
          <h3 class="uk-card-title">Browse Anime</h3>
          <p class="uk-text-meta">Search for anime to watch</p>
        </div>
      </a>
    </div>

    <template x-if="savedAnime.length > 0">
      <template x-for="anime in savedAnime" :key="anime.id">
        <div>
          <a class="uk-link-reset" :href="`${base_url}anime/watch/${anime.id}`">
            <div class="uk-card uk-card-default uk-card-hover">
              <div class="uk-card-media-top">
                <img uk-img :data-src="anime.cover_url" style="width:100%;height:200px;object-fit:cover;">
              </div>
              <div class="uk-card-body">
                <h3 class="uk-card-title break-word uk-margin-remove-bottom" x-text="anime.title"></h3>
              </div>
            </div>
          </a>
        </div>
      </template>
    </template>
  </div>

  <template x-if="continueWatching.length > 0">
    <div class="uk-margin-large-top">
      <h3>Continue Watching</h3>
      <div class="uk-grid-small uk-child-width-1-2 uk-child-width-1-4@m" uk-grid>
        <template x-for="item in continueWatching" :key="item.anime_id">
          <div>
            <a class="uk-link-reset" :href="`${base_url}anime/watch/${item.anime_id}`">
              <div class="uk-card uk-card-default uk-card-hover">
                <div class="uk-card-media-top">
                  <img uk-img :data-src="item.cover_url" style="width:100%;height:200px;object-fit:cover;">
                </div>
                <div class="uk-card-body">
                  <h3 class="uk-card-title break-word uk-margin-remove-bottom" x-text="item.title"></h3>
                  <p class="uk-text-meta uk-margin-remove-bottom" x-text="item.episode_info ? `Ep ${item.episode_info.number}` : (item.completed ? 'Completed' : 'In Progress')"></p>
                  <div class="uk-progress uk-margin-small-top" x-show="item.progress_pct > 0" style="height: 4px;">
                    <div class="uk-progress-bar" :style="`width: ${item.progress_pct}%`"></div>
                  </div>
                </div>
              </div>
            </a>
          </div>
        </template>
      </div>
    </div>
  </template>

  <p x-show="savedAnime.length === 0" class="uk-text-meta uk-margin-large-top">
    No anime in your library yet. <a href="<%= base_url %>anime/browse">Browse anime</a> to get started.
  </p>
</div>

<% content_for "script" do %>
  <script src="<%= base_url %>js/alert.js"></script>
  <script src="<%= base_url %>js/anime-home.js"></script>
<% end %>
