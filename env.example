# Port that exposes the HTTP frontend
PORT=9000

# Path to the mango main directory
# This directory holds the database and the library files
# Defaults to ./data/mango if not set
MAIN_DIRECTORY_PATH=

# Path to the mango config directory
# This directory holds the mango configuration path
# Defaults to ./data/config if not set
CONFIG_DIRECTORY_PATH=

# Docker image tags (override to use your own GHCR images)
# Defaults pull from ghcr.io/a730/mango:latest
# MANGO_IMAGE=ghcr.io/a730/mango:latest
# MIDDLEWARE_IMAGE=ghcr.io/a730/mango-anime-middleware:latest
